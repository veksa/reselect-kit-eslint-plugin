{
  "name": "eslint-plugin-reselect-kit",
  "version": "1.0.0",
  "description": "ESLint plugin to enforce best practices when using reselect and reselect-kit libraries",
  "keywords": [
    "eslint",
    "eslintplugin",
    "memoization",
    "reselect",
    "reselect-kit",
    "selector"
  ],
  "homepage": "https://github.com/veksa/reselect-kit-eslint-plugin",
  "author": {
    "name": "Aleksandr Khizhnyi",
    "email": "mendler88@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:veksa/reselect-kit-eslint-plugin.git"
  },
  "files": [
    "lib/"
  ],
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "lint": "oxlint src/ aliases.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "shx rm -rf lib && tsc --outDir lib -m node16 --moduleResolution node16 --declaration"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.66.0"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript-eslint/rule-tester": "^8.66.0",
    "@veksa/re-reselect": "^5.1.6",
    "@veksa/react-redux": "^9.3.2",
    "@veksa/reselect": "^5.2.2",
    "common-tags": "^1.8.2",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reselect-kit": "^1.1.2",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "typescript": ">=5.4 <6.1"
  },
  "packageManager": "yarn@4.10.3"
}
